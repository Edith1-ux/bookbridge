datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum BookMode {
  SELL
  EXCHANGE
  DONATE
}

enum ReservationStatus {
  PENDING
  APPROVED
  FULFILLED
  CANCELLED
  OVERDUE
}

enum SenderType {
  USER
  BOT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String        @id @default(uuid())
  name         String
  enrollment   String        @unique
  email        String        @unique
  password     String
  branch       String        @default("CE")
  semester     Int           @default(5)
  division     String        @default("Div A")
  role         Role          @default(STUDENT)
  whatsapp     String?
  rating       Float         @default(5.0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  books        Book[]        @relation("SellerBooks")
  reservations Reservation[]
  conversations Conversation[]
  memory       UserMemory?
  tickets      ProblemTicket[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Book {
  id             String        @id @default(uuid())
  title          String
  author         String
  isbn           String?
  gtuCode        String?
  resourceType   String        @default("textbook")
  genre          String        @default("Computer Science")
  subject        String        @default("Computer Science")
  branch         String        @default("CE")
  semester       Int           @default(5)
  edition        String        @default("Latest Edition")
  condition      String        @default("Like New")
  mode           BookMode      @default(SELL)
  price          Float         @default(0)
  originalPrice  Float?
  rating         Float         @default(4.8)
  exchangeFor    String?
  description    String?
  pdfUrl         String?
  status         String        @default("Available")
  sellerId       String
  seller         User          @relation("SellerBooks", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reservations   Reservation[]

  @@map("books")
}

model Reservation {
  id          String            @id @default(uuid())
  bookId      String
  userId      String
  status      ReservationStatus @default(PENDING)
  reservedAt  DateTime          @default(now())
  dueDate     DateTime?
  returnedAt  DateTime?
  fineAmount  Float             @default(0)

  book        Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model Conversation {
  id          String        @id @default(uuid())
  userId      String
  title       String        @default("Chat Support")
  status      String        @default("Active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderType     SenderType   @default(USER)
  message        String
  intent         String?
  sentiment      String?
  executedQuery  String?
  responseData   Json?
  executionMs    Int?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model UserMemory {
  id              String   @id @default(uuid())
  userId          String   @unique
  preferences     Json?
  lastSearchQuery String?
  favoriteSubject String?
  resolvedIssues  String[] @default([])
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_memories")
}

model ProblemTicket {
  id          String       @id @default(uuid())
  userId      String
  issueType   String
  description String
  status      TicketStatus @default(OPEN)
  solution    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("problem_tickets")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  endpoint    String
  ipAddress   String?
  executionMs Int
  statusCode  Int
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
