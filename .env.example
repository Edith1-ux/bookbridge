# ============================================================
# BookBridge — Required Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# --- Django Core ---
SECRET_KEY=your-secret-key-here-at-least-50-chars
DEBUG=False
DEMO_MODE=false
ALLOWED_HOSTS=your-domain.onrender.com,localhost

# --- Database (MySQL) ---
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=bookbridge_db
MYSQL_USER=bookbridge_user
MYSQL_PASSWORD=your-mysql-password

# --- Redis (Required for Django Channels WebSockets & Cache) ---
REDIS_URL=rediss://your-redis-host:6380

# --- AI / LLM (Optional: enables AI Academic Assistant) ---
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# --- Media / Object Storage (Optional: S3 / Cloudflare R2) ---
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=https://your-r2-account.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=media.yourdomain.com

# --- CORS / CSRF (Required for separate frontend deployments) ---
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.onrender.com

# --- Payments (Optional: Razorpay gateway) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
