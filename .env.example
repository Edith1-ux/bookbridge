# =============================================================================
# BookBridge 2.0 — Production Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env with real secrets to version control.
# =============================================================================

# Server Settings
PORT=8000
NODE_ENV=development

# JWT Authentication (REQUIRED IN PRODUCTION)
# Generate a secure 64-byte key using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-random-64-character-jwt-secret-here
JWT_EXPIRES_IN=7d

# Primary MySQL Database (REQUIRED IN PRODUCTION)
# Option A: Full Connection URL (e.g. Render MySQL, Railway, Aiven, TiDB)
DATABASE_URL=mysql://username:password@hostname:3306/bookbridge_db

# Option B: Individual MySQL Parameters (Alternative to DATABASE_URL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bookbridge
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
DB_LOGGING=false

# CORS & Domain Whitelisting
# Comma-separated allowed origins (e.g. your custom domain or Render URL)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080,https://bookbridge.onrender.com

# Optional: Cloud Storage (AWS S3 or Cloudflare R2 for durable cover images)
# AWS_STORAGE_BUCKET_NAME=bookbridge-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
