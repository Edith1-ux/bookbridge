# =============================================================================
# BookBridge — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore
# =============================================================================

# Server
PORT=8000
NODE_ENV=development

# MySQL Database Connection (optional — falls back to JSON file if not set)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bookbridge
MYSQL_USER=root
MYSQL_PASSWORD=

# MongoDB Connection (legacy optional fallback)
MONGO_URI=mongodb://127.0.0.1:27017/bookbridge

# JWT Authentication — REQUIRED IN PRODUCTION
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be set via environment variable — never hardcode in source code
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# Token expiry
JWT_EXPIRES_IN=7d

# CORS — set to your production domain in production
CLIENT_URL=http://localhost:8000

# Optional — CORS_ORIGIN should NOT be wildcard * in production
CORS_ORIGIN=http://localhost:8000

# Optional — OpenAI (for AI recommendations feature)
# OPENAI_API_KEY=sk-...

# Optional — Redis (for session/cache in production)
# REDIS_URL=redis://localhost:6379
