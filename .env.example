# ============================================================
# BookBridge — Required Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# --- Django Core ---
SECRET_KEY=your-secret-key-here-at-least-50-chars
DEBUG=False
DEMO_MODE=false
ALLOWED_HOSTS=your-domain.onrender.com,localhost

# --- Database (MySQL) ---
# IMPORTANT: You MUST provide real database credentials from your MySQL provider
# (e.g. TiDB Cloud: tidbcloud.com, Aiven: aiven.io, Railway: railway.app, AWS RDS).
# NEVER enter literal placeholder strings like "your-mysql-host" into Render.
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DATABASE=bookbridge_db
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_actual_db_password
# Alternatively, set a complete connection URL:
# DATABASE_URL=mysql://your_user:your_password@your_host:3306/bookbridge_db

# --- Redis (Required for Django Channels WebSockets & Cache) ---
REDIS_URL=rediss://your-redis-host:6380

# --- AI / LLM (Optional: enables AI Academic Assistant) ---
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# --- Media / Object Storage (Optional: S3 / Cloudflare R2) ---
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=https://your-r2-account.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=media.yourdomain.com

# --- CORS / CSRF (Required for separate frontend deployments) ---
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.onrender.com

# --- Payments (Optional: Razorpay gateway) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
