# =============================================================================
# BookBridgee — Production Environment Configuration
# Copy this file to .env and configure for your local or cloud environment.
# Use MySQL in local and production environments. Do not use SQLite in production.
# NEVER commit .env with production credentials to source control.
# =============================================================================

# Django Security
SECRET_KEY=django-insecure-change-this-to-a-strong-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,bookbridge.onrender.com

# Database — MySQL Configuration (Mandatory)
# Use MySQL in local and production environments. Do not use SQLite in production.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bookbridge_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
 
# Throttling & Demo Mode
DEMO_MODE=false

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://bookbridge.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://bookbridge.onrender.com
SECURE_SSL_REDIRECT=False

# Payment Gateway (Optional - defaults to Campus Direct Handover if not set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Academic Assistant (Optional - Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
